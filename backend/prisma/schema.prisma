generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  STUDENT @map("student")
  ALUMNI  @map("alumni")
}

enum FollowRequestStatus {
  PENDING   @map("pending")
  ACCEPTED  @map("accepted")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")
}

enum PostType {
  GENERAL      @map("general")
  OPPORTUNITY  @map("opportunity")
  EVENT        @map("event")
  CLUB_ACTIVITY @map("club_activity")
}

enum OpportunityType {
  INTERNSHIP @map("internship")
  HACKATHON  @map("hackathon")
  EVENT      @map("event")
  CONTEST    @map("contest")
  CLUB       @map("club")
}

enum PostVisibility {
  PUBLIC       @map("public")
  FOLLOWERS    @map("followers")
  CLUB_MEMBERS @map("club_members")
}

enum ClubMembershipRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")
}

enum ClubMembershipStatus {
  ACTIVE  @map("active")
  PENDING @map("pending")
  INVITED @map("invited")
  REMOVED @map("removed")
  LEFT    @map("left")
}

enum ClubPrivacy {
  OPEN    @map("open")
  REQUEST @map("request")
  PRIVATE @map("private")
}

enum ClubRestrictionType {
  POSTING_BLOCKED  @map("posting_blocked")
  COMMENT_BLOCKED  @map("comment_blocked")
  MEMBERSHIP_BAN   @map("membership_ban")
}

enum ChatType {
  DIRECT @map("direct")
  GROUP  @map("group")
}

enum ChatParticipantRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")
}

enum AdminRole {
  SUPER_ADMIN @map("super_admin")
}

enum AdminSeverity {
  INFO     @map("info")
  WARNING  @map("warning")
  CRITICAL @map("critical")
}

enum AdminReportTargetType {
  USER    @map("user")
  POST    @map("post")
  COMMENT @map("comment")
  MESSAGE @map("message")
  CLUB    @map("club")
}

enum AdminReportStatus {
  PENDING      @map("pending")
  UNDER_REVIEW @map("under_review")
  RESOLVED     @map("resolved")
  DISMISSED    @map("dismissed")
}

enum ModerationActionType {
  WARN           @map("warn")
  SUSPEND        @map("suspend")
  UNSUSPEND      @map("unsuspend")
  BAN            @map("ban")
  UNBAN          @map("unban")
  DELETE_POST    @map("delete_post")
  DELETE_COMMENT @map("delete_comment")
  DELETE_MESSAGE @map("delete_message")
  DELETE_MEDIA   @map("delete_media")
  DISMISS        @map("dismiss")
  RESOLVE        @map("resolve")
}

enum VerificationRequestType {
  STUDENT @map("student")
  ALUMNI  @map("alumni")
  CLUB    @map("club")
}

enum VerificationRequestStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  MORE_INFO @map("more_info")
}

enum UserVerificationState {
  STUDENT_GOOGLE_VERIFIED @map("student_google_verified")
  ALUMNI_PENDING_REVIEW   @map("alumni_pending_review")
  ALUMNI_VERIFIED         @map("alumni_verified")
  ALUMNI_REJECTED         @map("alumni_rejected")
}

enum AuthProvider {
  GOOGLE @map("google")
  MAGIC_LINK  @map("magic_link")
}

enum AnnouncementStatus {
  DRAFT     @map("draft")
  SCHEDULED @map("scheduled")
  PUBLISHED @map("published")
}

enum MessageType {
  TEXT   @map("text")
  IMAGE  @map("image")
  FILE   @map("file")
  SYSTEM @map("system")
}

model User {
  userId                 String              @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  displayName            String              @map("display_name") @db.VarChar(100)
  username               String              @unique @db.VarChar(50)
  email                  String              @unique @db.VarChar(100)
  passwordHash           String              @map("password_hash") @db.VarChar(255)
  userType               UserType            @map("user_type")
  authProvider           AuthProvider        @default(MAGIC_LINK) @map("auth_provider")
  googleSubject          String?             @unique @map("google_subject") @db.VarChar(255)
  bio                    String?             @db.VarChar(500)
  headline               String?             @db.VarChar(255)
  profilePhotoUrl        String?             @map("profile_photo_url") @db.Text
  coverPhotoUrl          String?             @map("cover_photo_url") @db.Text
  isPrivate              Boolean             @default(false) @map("is_private")
  isActive               Boolean             @default(true) @map("is_active")
  isBanned               Boolean             @default(false) @map("is_banned")
  bannedAt               DateTime?           @map("banned_at") @db.Timestamp(6)
  suspensionStartedAt    DateTime?           @map("suspension_started_at") @db.Timestamp(6)
  suspendedUntil         DateTime?           @map("suspended_until") @db.Timestamp(6)
  suspensionReason       String?             @map("suspension_reason") @db.Text
  warningCount           Int                 @default(0) @map("warning_count")
  lastWarningAt          DateTime?           @map("last_warning_at") @db.Timestamp(6)
  onboardingCompletedAt  DateTime?           @map("onboarding_completed_at") @db.Timestamp(6)
  verifiedAt             DateTime?           @map("verified_at") @db.Timestamp(6)
  verificationState      UserVerificationState? @map("verification_state")
  isOnline               Boolean             @default(false) @map("is_online")
  lastSeenAt             DateTime?           @map("last_seen_at") @db.Timestamp(6)
  lastLoginAt            DateTime?           @map("last_login_at") @db.Timestamp(6)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamp(6)
  studentProfile         StudentProfile?
  alumniProfile          AlumniProfile?
  settings               UserSetting?
  sessions               UserSession[]
  skills                 UserSkill[]
  certifications         UserCertification[]
  projects               UserProject[]
  experiences            UserExperience[]
  societies              UserSociety[]
  achievements           UserAchievement[]
  blocksInitiated        BlockedUser[]        @relation("BlockedUserBlocker")
  blocksReceived         BlockedUser[]        @relation("BlockedUserBlocked")
  followRequestsSent     FollowRequest[]     @relation("FollowRequestRequester")
  followRequestsReceived FollowRequest[]     @relation("FollowRequestTarget")
  following              Follow[]            @relation("FollowFollower")
  followers              Follow[]            @relation("FollowFollowed")
  clubsCreated           Club[]              @relation("ClubCreator")
  clubMemberships        ClubMembership[]
  clubCategoriesCreated  ClubCategory[]      @relation("ClubCategoryCreator")
  clubRestrictionsIssued ClubMemberRestriction[] @relation("ClubRestrictionActor")
  clubRestrictions       ClubMemberRestriction[] @relation("ClubRestrictionTarget")
  authoredPosts          Post[]              @relation("PostAuthor")
  postLikes              PostLike[]
  postComments           PostComment[]       @relation("PostCommentAuthor")
  postCommentLikes       PostCommentLike[]
  postSaves              PostSave[]
  chatsCreated           Chat[]              @relation("ChatCreator")
  chatParticipants       ChatParticipant[]
  messagesSent           Message[]           @relation("MessageSender")
  notifications          Notification[]      @relation("NotificationUser")
  notificationsActed     Notification[]      @relation("NotificationActor")
  pushSubscriptions      UserPushSubscription[]
  adminAccount           AdminAccount?
  adminAuditLogs         AdminAuditLog[]     @relation("AdminAuditActor")
  adminAssignedReports   AdminReport[]       @relation("AdminAssignedReports")
  adminReviewedReports   AdminReport[]       @relation("AdminReviewedReports")
  adminReportNotes       AdminReportNote[]   @relation("AdminReportNoteAuthor")
  reportSubmissions      ReportSubmission[]  @relation("ReportSubmissionReporter")
  moderationLogsAuthored ModerationLog[]     @relation("ModerationLogAdmin")
  moderationLogsTargeted ModerationLog[]     @relation("ModerationLogTargetUser")
  reviewedVerificationRequests AdminVerificationRequest[] @relation("AdminVerificationReviewer")
  announcementsCreated   AdminAnnouncement[] @relation("AdminAnnouncementCreator")

  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
  @@index([userType], map: "idx_users_user_type")
  @@map("users")
}

model UserSession {
  sessionId    String    @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.Text
  browserName  String?   @map("browser_name") @db.VarChar(100)
  platform     String?   @db.VarChar(100)
  deviceName   String?   @map("device_name") @db.VarChar(100)
  locationLabel String?  @map("location_label") @db.VarChar(255)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamp(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamp(6)
  user         User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_user_sessions_user_id")
  @@index([revokedAt], map: "idx_user_sessions_revoked_at")
  @@map("user_sessions")
}

model StudentProfile {
  userId    String   @id @map("user_id") @db.Uuid
  branch    String   @db.VarChar(100)
  year      Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@map("student_profiles")
}

model AlumniProfile {
  userId        String   @id @map("user_id") @db.Uuid
  branch        String   @db.VarChar(100)
  passingYear   Int      @map("passing_year")
  currentStatus String?  @map("current_status") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  user          User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@map("alumni_profiles")
}

model UserSetting {
  userId                      String   @id @map("user_id") @db.Uuid
  emailNotifications          Boolean  @default(true) @map("email_notifications")
  followRequestNotifications  Boolean  @default(true) @map("follow_request_notifications")
  messageNotifications        Boolean  @default(true) @map("message_notifications")
  opportunityAlerts           Boolean  @default(true) @map("opportunity_alerts")
  clubUpdateNotifications     Boolean  @default(true) @map("club_update_notifications")
  weeklyDigestEnabled         Boolean  @default(false) @map("weekly_digest_enabled")
  showEmail                   Boolean  @default(true) @map("show_email")
  showProjects                Boolean  @default(true) @map("show_projects")
  allowMessages               Boolean  @default(true) @map("allow_messages")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  user                        User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_settings")
}

model UserSkill {
  userSkillId String   @id @default(dbgenerated("gen_random_uuid()")) @map("user_skill_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, name], map: "uq_user_skills_user_id_name")
  @@index([userId], map: "idx_user_skills_user_id")
  @@map("user_skills")
}

model AuthOnboardingSession {
  authOnboardingSessionId String       @id @default(dbgenerated("gen_random_uuid()")) @map("auth_onboarding_session_id") @db.Uuid
  provider                AuthProvider @map("provider")
  email                   String       @db.VarChar(100)
  googleSubject           String?      @unique @map("google_subject") @db.VarChar(255)
  fullName                String       @map("full_name") @db.VarChar(150)
  profilePhotoUrl         String?      @map("profile_photo_url") @db.Text
  suggestedUsername       String?      @map("suggested_username") @db.VarChar(50)
  payload                 Json         @default("{}") @db.JsonB
  expiresAt               DateTime     @map("expires_at") @db.Timestamp(6)
  completedAt             DateTime?    @map("completed_at") @db.Timestamp(6)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([email], map: "idx_auth_onboarding_sessions_email")
  @@index([expiresAt], map: "idx_auth_onboarding_sessions_expires_at")
  @@map("auth_onboarding_sessions")
}

model UserCertification {
  certificationId String    @id @default(dbgenerated("gen_random_uuid()")) @map("certification_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String    @db.VarChar(255)
  issuer          String?   @db.VarChar(255)
  description     String?   @db.Text
  credentialUrl   String?   @map("credential_url") @db.Text
  imageUrl        String?   @map("image_url") @db.Text
  issuedAt        DateTime? @map("issued_at") @db.Timestamp(6)
  expiresAt       DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  user            User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_user_certifications_user_id")
  @@map("user_certifications")
}

model UserProject {
  projectId    String       @id @default(dbgenerated("gen_random_uuid()")) @map("project_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  title        String       @db.VarChar(255)
  description  String       @db.Text
  sourceUrl    String?      @map("source_url") @db.Text
  demoUrl      String?      @map("demo_url") @db.Text
  imageUrl     String?      @map("image_url") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  user         User         @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  projectTags  ProjectTag[]

  @@index([userId], map: "idx_user_projects_user_id")
  @@map("user_projects")
}

model ProjectTag {
  projectId String      @map("project_id") @db.Uuid
  tagName   String      @map("tag_name") @db.VarChar(100)
  project   UserProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade, onUpdate: NoAction)

  @@id([projectId, tagName])
  @@index([tagName], map: "idx_project_tags_tag_name")
  @@map("project_tags")
}

model UserExperience {
  experienceId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("experience_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  roleTitle     String    @map("role_title") @db.VarChar(255)
  organization  String    @db.VarChar(255)
  description   String?   @db.Text
  startDate     DateTime  @map("start_date") @db.Timestamp(6)
  endDate       DateTime? @map("end_date") @db.Timestamp(6)
  isCurrent     Boolean   @default(false) @map("is_current")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  user          User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_user_experiences_user_id")
  @@map("user_experiences")
}

model UserSociety {
  userSocietyId String    @id @default(dbgenerated("gen_random_uuid()")) @map("user_society_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  societyName   String    @map("society_name") @db.VarChar(255)
  roleName      String    @map("role_name") @db.VarChar(255)
  startDate     DateTime? @map("start_date") @db.Timestamp(6)
  endDate       DateTime? @map("end_date") @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  user          User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_user_societies_user_id")
  @@map("user_societies")
}

model UserAchievement {
  achievementId    String   @id @default(dbgenerated("gen_random_uuid()")) @map("achievement_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  achievementYear  Int      @map("achievement_year")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  user             User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_user_achievements_user_id")
  @@map("user_achievements")
}

model FollowRequest {
  followRequestId String              @id @default(dbgenerated("gen_random_uuid()")) @map("follow_request_id") @db.Uuid
  requesterUserId String              @map("requester_user_id") @db.Uuid
  targetUserId    String              @map("target_user_id") @db.Uuid
  status          FollowRequestStatus
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  respondedAt     DateTime?           @map("responded_at") @db.Timestamp(6)
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamp(6)
  requester       User                @relation("FollowRequestRequester", fields: [requesterUserId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  target          User                @relation("FollowRequestTarget", fields: [targetUserId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([requesterUserId], map: "idx_follow_requests_requester_user_id")
  @@index([targetUserId], map: "idx_follow_requests_target_user_id")
  @@index([status], map: "idx_follow_requests_status")
  @@map("follow_requests")
}

model Follow {
  followerUserId String   @map("follower_user_id") @db.Uuid
  followedUserId String   @map("followed_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  follower       User     @relation("FollowFollower", fields: [followerUserId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  followed       User     @relation("FollowFollowed", fields: [followedUserId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([followerUserId, followedUserId])
  @@index([followedUserId], map: "idx_follows_followed_user_id")
  @@index([followerUserId], map: "idx_follows_follower_user_id")
  @@map("follows")
}

model Club {
  clubId           String           @id @default(dbgenerated("gen_random_uuid()")) @map("club_id") @db.Uuid
  name             String           @db.VarChar(255)
  slug             String           @unique @db.VarChar(255)
  shortDescription String?          @map("short_description") @db.VarChar(255)
  description      String?          @db.Text
  privacy          ClubPrivacy      @default(OPEN)
  avatarUrl        String?          @map("avatar_url") @db.Text
  coverImageUrl    String?          @map("cover_image_url") @db.Text
  linkedChatId     String?          @map("linked_chat_id") @db.Uuid
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  primaryCategoryId String?         @map("primary_category_id") @db.Uuid
  isVerified       Boolean          @default(false) @map("is_verified")
  featuredAt       DateTime?        @map("featured_at") @db.Timestamp(6)
  frozenAt         DateTime?        @map("frozen_at") @db.Timestamp(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamp(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy        User             @relation("ClubCreator", fields: [createdByUserId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  primaryCategory  ClubCategory?    @relation(fields: [primaryCategoryId], references: [clubCategoryId], onDelete: SetNull, onUpdate: NoAction)
  memberships      ClubMembership[]
  posts            Post[]           @relation("ClubPosts")
  tags             ClubTagOnClub[]
  restrictions     ClubMemberRestriction[]

  @@index([slug], map: "idx_clubs_slug")
  @@index([createdByUserId], map: "idx_clubs_created_by_user_id")
  @@index([primaryCategoryId], map: "idx_clubs_primary_category_id")
  @@map("clubs")
}

model ClubMembership {
  clubMembershipId String               @id @default(dbgenerated("gen_random_uuid()")) @map("club_membership_id") @db.Uuid
  clubId           String               @map("club_id") @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  role             ClubMembershipRole
  status           ClubMembershipStatus
  joinedAt         DateTime?            @map("joined_at") @db.Timestamp(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)
  club             Club                 @relation(fields: [clubId], references: [clubId], onDelete: Cascade, onUpdate: NoAction)
  user             User                 @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  restrictions     ClubMemberRestriction[]

  @@unique([clubId, userId], map: "uq_club_memberships_club_id_user_id")
  @@index([userId], map: "idx_club_memberships_user_id")
  @@index([status], map: "idx_club_memberships_status")
  @@map("club_memberships")
}

model ClubCategory {
  clubCategoryId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("club_category_id") @db.Uuid
  displayName     String    @map("display_name") @db.VarChar(100)
  normalizedName  String    @unique @map("normalized_name") @db.VarChar(100)
  isSystem        Boolean   @default(false) @map("is_system")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy       User?     @relation("ClubCategoryCreator", fields: [createdByUserId], references: [userId], onDelete: SetNull, onUpdate: NoAction)
  clubs           Club[]

  @@index([isSystem], map: "idx_club_categories_is_system")
  @@map("club_categories")
}

model ClubTag {
  clubTagId       String        @id @default(dbgenerated("gen_random_uuid()")) @map("club_tag_id") @db.Uuid
  displayName     String        @map("display_name") @db.VarChar(100)
  normalizedName  String        @unique @map("normalized_name") @db.VarChar(100)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  clubs           ClubTagOnClub[]

  @@index([normalizedName], map: "idx_club_tags_normalized_name")
  @@map("club_tags")
}

model ClubTagOnClub {
  clubId     String   @map("club_id") @db.Uuid
  clubTagId  String   @map("club_tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  club       Club     @relation(fields: [clubId], references: [clubId], onDelete: Cascade, onUpdate: NoAction)
  tag        ClubTag  @relation(fields: [clubTagId], references: [clubTagId], onDelete: Cascade, onUpdate: NoAction)

  @@id([clubId, clubTagId])
  @@index([clubTagId], map: "idx_club_tags_on_clubs_tag_id")
  @@map("club_tags_on_clubs")
}

model ClubMemberRestriction {
  clubMemberRestrictionId String               @id @default(dbgenerated("gen_random_uuid()")) @map("club_member_restriction_id") @db.Uuid
  clubId                  String               @map("club_id") @db.Uuid
  clubMembershipId        String               @map("club_membership_id") @db.Uuid
  userId                  String               @map("user_id") @db.Uuid
  imposedByUserId         String?              @map("imposed_by_user_id") @db.Uuid
  restrictionType         ClubRestrictionType  @map("restriction_type")
  reason                  String?              @db.Text
  expiresAt               DateTime?            @map("expires_at") @db.Timestamp(6)
